# Copy to .env. Keep credentials on the server; never commit .env.
# OpenAI or an explicitly configured OpenAI-compatible vision provider.
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
# Set the exact image-capable model ID available in your account.
VISION_MODEL=
# json_schema (default) requires structured-output support.
# Use json_object only if your compatible provider requires it.
VISION_RESPONSE_FORMAT=json_schema
PORT=4399
